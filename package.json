{
  "name": "opencode-session-cost",
  "version": "1.0.0",
  "description": "OpenCode TUI plugin that shows subagent cost breakdown in the sidebar, using only OpenCode's own local session data.",
  "type": "module",
  "main": "dist/tui.js",
  "types": "dist/tui.d.ts",
  "exports": {
    ".": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    }
  },
  "files": [
    "tui.js",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "opencode": "^2.0.28",
    "node": ">=18"
  },
  "scripts": {
    "build": "bun scripts/build.ts && tsc --emitDeclarationOnly",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "tui",
    "session",
    "cost",
    "subagent"
  ],
  "author": "Igor Velho",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorvelho/opencode-session-cost.git"
  },
  "bugs": {
    "url": "https://github.com/igorvelho/opencode-session-cost/issues"
  },
  "homepage": "https://github.com/igorvelho/opencode-session-cost#readme",
  "dependencies": {
    "@opencode/plugin": "^2.0.28"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.8",
    "@opentui/solid": "^0.5.8",
    "solid-js": "^1.9.0",
    "@types/bun": "latest",
    "semantic-release": "^25.0.7",
    "typescript": "^5.7.3"
  }
}
